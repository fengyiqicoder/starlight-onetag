    ".": "./index.js",
    "./Search.astro": "./components/Search.astro"
  },
  "files": ["index.js", "components", "README.md", "LICENSE"],
  "dependencies": {
    "onetag": "^1.2.0"
  },
  "peerDependencies": {
    "@astrojs/starlight": ">=0.32.0",
    "astro": ">=5.0.0"
